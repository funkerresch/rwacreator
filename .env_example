APPLE_ID="..."
# "Developer ID Application: Your Name (TEAMID)" — from `security find-identity -v -p codesigning`
TEAM_ID="TEAM NAME (...)"
# Apple notarization credentials — store in a keychain profile (recommended):
#   xcrun notarytool store-credentials "rwa-notary" \
#       --apple-id you@example.com --team-id XXXXXXXXXX --password <app-specific-password>
PROFILE="..."

# =============================================================================
# target selection
# =============================================================================
BUILD=1
BUILD_INSTALLER=0
CODESIGN=0
NOTARIZE=0
